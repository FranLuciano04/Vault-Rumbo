.trash/

# Sistema
.DS_Store
Thumbs.db

# Se versiona el resto de .obsidian/ (plugins y config compartida del equipo)

# Referencia local de la paleta (ya cargada como variables en Figma)
paletaColores/
node_modules/
package-lock.json

# Carpeta de entrega del PC1: se arma con 07-Entregables/build/armar-entrega.sh
07-Entregables/PC1/Rumbo — Entrega PC1/
# Archivos temporales de Office (documento abierto)
~$*

# Implementación (DEC-0014): worktrees de Claude Code, dependencias y secretos del código en src/
.claude/worktrees/
.claude/settings.local.json
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
src/**/dist/
src/**/build/
src/**/coverage/
.expo/
.env
.env.*
!.env.example

# Firebase (DEC-0016): logs del emulador y, por si se descarga dentro del repo, la cuenta de
# servicio (nombre por defecto de la consola). Su lugar es fuera del repo (src/infra/firebase.md).
*-debug.log
*-firebase-adminsdk-*.json
**/serviceAccount*.json
**/*cuenta-de-servicio*.json
**/*service-account*.json

# Temporal de pytest cuando el del sistema no se puede usar (Spec §4)
src/**/.pytest_tmp/
