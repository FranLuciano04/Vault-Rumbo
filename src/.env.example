# Credenciales locales de PostgreSQL para docker-compose.dev.yml.
# Copiar a src/.env (fuera de Git) y reemplazar el valor de RUMBO_DB_PASSWORD.
RUMBO_DB_USER=rumbo
RUMBO_DB_PASSWORD=cambiar-por-una-clave-local

# Opcional: puertos del host si 5432 o 5433 están ocupados (valores por defecto: 5432 y 5433).
# RUMBO_DEV_PORT=5432
# RUMBO_TEST_PORT=5433

# docker-compose.yml (producción local para las demos). Usar una clave alfanumérica: va dentro de
# la URL de la base. Todo es opcional salvo las dos RUMBO_DB_* de arriba.
# RUMBO_HTTP_PORT=80                      # puerto del host para la web y /api
# FIREBASE_PROJECT_ID=demo-rumbo          # proyecto contra el que la API valida tokens
# VITE_FIREBASE_API_KEY=demo-key          # config pública del SDK web, se incrusta en el build
# VITE_FIREBASE_AUTH_DOMAIN=demo-rumbo.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-rumbo
# VITE_FIREBASE_APP_ID=demo-app-id

# docker-compose.firebase.yml (proyecto real de Firebase): ruta en el host al JSON de la cuenta de
# servicio, guardado FUERA del repo. Obligatoria solo con ese override. Ver src/infra/firebase.md.
# RUMBO_FIREBASE_CREDENCIALES=C:/Users/<usuario>/.rumbo/firebase-cuenta-de-servicio.json
