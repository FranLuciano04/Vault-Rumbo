EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Firebase Authentication (DEC-0016): config pública del SDK, no es secreta.
# Los valores de abajo sirven para el Auth Emulator (proyecto demo-rumbo, sin internet).
# Con el proyecto real, se copian de la consola (ver src/infra/firebase.md).
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-rumbo.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-rumbo
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app-id
# Login con Google: el «Web client ID» OAuth del proyecto (consola de Firebase → Google). Público.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Solo desarrollo: URL del Auth Emulator vista desde el emulador de Android.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099
