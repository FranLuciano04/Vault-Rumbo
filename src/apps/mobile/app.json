{
  "expo": {
    "name": "Rumbo",
    "slug": "rumbo",
    "scheme": "rumbo",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "android": {
      "package": "ar.com.rumbo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#234f6e"
      }
    },
    "ios": {
      "bundleIdentifier": "ar.com.rumbo.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
