# Configuración local de la web. Copiar a src/apps/web/.env (ignorado por Git) y ajustar.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# URL base de la API. Vacía: mismo origen que la web (detrás de nginx en producción).
# Con pnpm dev no hace falta: Vite reenvía /api a http://127.0.0.1:8000
# (otro destino: RUMBO_API_PROXY en este .env, p. ej. RUMBO_API_PROXY=http://127.0.0.1:8001;
# no lleva prefijo VITE_ porque solo lo lee el dev server y no debe llegar al bundle).
# VITE_API_URL=http://localhost:8000

# Firebase Authentication (DEC-0016). Es la config pública del SDK web: no es secreta.
# Los valores de abajo sirven para el Auth Emulator (proyecto demo-rumbo, sin internet).
# Con el proyecto real, se copian de la consola (ver src/infra/firebase.md).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rumbo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rumbo
VITE_FIREBASE_APP_ID=demo-app-id

# Solo desarrollo: URL del Auth Emulator (ver src/infra/firebase.md). Descomentarla para usarlo;
# sin esta variable la web usa el proyecto real. Nunca en el build del servidor.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
