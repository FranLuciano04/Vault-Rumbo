# Configuración local del backend. Copiar a src/backend/.env (ignorado por Git)
# y ajustar. Las bases las levanta src/docker-compose.dev.yml (DEC-0015 §1).
# Reemplazar la contraseña por la de RUMBO_DB_PASSWORD de src/.env.

# Base de desarrollo (puerto 5432).
DATABASE_URL=postgresql+asyncpg://rumbo:cambiar-por-una-clave-local@localhost:5432/rumbo

# Base de tests (puerto 5433, en tmpfs).
TEST_DATABASE_URL=postgresql+asyncpg://rumbo:cambiar-por-una-clave-local@localhost:5433/rumbo_test
