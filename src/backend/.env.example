# Configuración local del backend. Copiar a src/backend/.env (ignorado por Git)
# y ajustar. Las bases las levanta src/docker-compose.dev.yml (DEC-0015 §1).
# Reemplazar la contraseña por la de RUMBO_DB_PASSWORD de src/.env.
#
# La contraseña va dentro de la URL: conviene una clave alfanumérica, o codificar
# los caracteres especiales con %XX (por ejemplo, @ es %40 y : es %3A).
#
# Si cambiaron RUMBO_DEV_PORT o RUMBO_TEST_PORT en src/.env, usen esos puertos
# en las URLs de abajo (en vez de 5432 y 5433).

# Base de desarrollo (puerto 5432 por defecto).
DATABASE_URL=postgresql+asyncpg://rumbo:cambiar-por-una-clave-local@localhost:5432/rumbo

# Base de tests (puerto 5433 por defecto, en tmpfs).
TEST_DATABASE_URL=postgresql+asyncpg://rumbo:cambiar-por-una-clave-local@localhost:5433/rumbo_test

# Firebase Authentication (DEC-0016). Los tests no lo usan: inyectan un verificador falso.
# Proyecto real, emulador y variables del servidor: src/infra/firebase.md.
# Proyecto contra el que se validan los ID tokens (con el emulador: demo-rumbo).
FIREBASE_PROJECT_ID=demo-rumbo
# Ruta al JSON de la cuenta de servicio, guardado FUERA del repo. Solo con el proyecto real;
# sin ella se usan las credenciales por defecto de Google (ADC).
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/fuera/del/repo/cuenta-de-servicio.json
# Solo desarrollo: Auth Emulator local. Con esta variable los tokens NO se verifican con
# firma; el backend no arranca si está configurada y ENTORNO no es `desarrollo`.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Entorno de ejecución: en tu PC poné `desarrollo` si usás el emulador; en el servidor se
# omite y queda en `produccion`, que rechaza el emulador.
# ENTORNO=desarrollo
