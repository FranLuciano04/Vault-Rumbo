{
  "openapi": "3.1.0",
  "info": {
    "title": "Rumbo",
    "version": "0.1.0"
  },
  "paths": {
    "/api/salud": {
      "get": {
        "summary": "Salud",
        "operationId": "salud_api_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Salud Api Salud Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/yo": {
      "get": {
        "tags": [
          "seguridad"
        ],
        "summary": "Usuario de la sesión, con su rol y accesos",
        "description": "**Roles:** admin, dueno, empleado, freelance.\n\n**Casos de uso:** CU-24.",
        "operationId": "obtener_usuario_actual",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioActual"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          },
          "501": {
            "description": "No implementado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCampo": {
        "properties": {
          "campo": {
            "type": "string",
            "title": "Campo"
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje"
          }
        },
        "type": "object",
        "required": [
          "campo",
          "mensaje"
        ],
        "title": "ErrorCampo"
      },
      "Problema": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errores": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorCampo"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errores"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problema"
      },
      "UsuarioActual": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "rol": {
            "type": "string",
            "enum": [
              "admin",
              "dueno",
              "empleado",
              "freelance"
            ],
            "title": "Rol"
          },
          "acceso_redes": {
            "type": "boolean",
            "title": "Acceso Redes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "email",
          "rol",
          "acceso_redes"
        ],
        "title": "UsuarioActual",
        "description": "Usuario de Rumbo de la sesión, con su rol y accesos."
      },
      "Pagina": {
        "properties": {
          "items": {
            "items": {},
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "pagina": {
            "title": "Pagina",
            "type": "integer"
          },
          "por_pagina": {
            "title": "Por Pagina",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "pagina",
          "por_pagina"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "ID token de Firebase (DEC-0016)",
        "scheme": "bearer"
      }
    }
  }
}
